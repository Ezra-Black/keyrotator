{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Ezra-Black/rekey",
  "title": "rekey",
  "description": "Rotate API keys across AWS, GitLab, Cloudflare, OpenAI & more. Secrets never reach the model.",
  "repository": {
    "url": "https://github.com/Ezra-Black/rekey",
    "source": "github"
  },
  "websiteUrl": "https://github.com/Ezra-Black/rekey",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "rekey",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP server. Add --allow-rotate / --allow-retire to enable write tools."
        }
      ]
    }
  ]
}
